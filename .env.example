# ==============================================================================
# ChatAgent Environment Configuration
# ==============================================================================

# --- REQUIRED: LLM API Configuration ---
# Google Gemini (Default via OpenAI compatibility layer)
LLM_API_KEY=your_gemini_api_key_here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FAST_MODEL=gemini-3.5-flash-lite
DEEP_MODEL=gemini-3.5-flash
REASONING_EFFORT=low

# Alternative: Groq OpenAI-compatible endpoint
# LLM_API_KEY=your_groq_api_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# FAST_MODEL=llama-3.1-8b-instant
# DEEP_MODEL=llama-3.3-70b-versatile
# REASONING_EFFORT=low

# --- REQUIRED: Web Search API ---
# Tavily Search API key (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# --- REQUIRED: PostgreSQL Database ---
# Neon Serverless Postgres pooled connection string
# (e.g. postgresql://user:pass@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require)
DATABASE_URL=postgresql://user:pass@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require

# --- OPTIONAL: Runtime & Observability ---
# Web server port (Default: 3000)
PORT=3000

# User IANA timezone (Defaults to system timezone, e.g. Asia/Kolkata, America/New_York)
USER_TZ=Asia/Kolkata

# Log level: debug | info | warn | error (Default: info)
LOG_LEVEL=info
