# LLM configuration (OpenAI-compatible endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
FAST_MODEL=gemini-2.5-flash
DEEP_MODEL=gemini-2.5-flash

# Alternative: Groq OpenAI-compatible endpoint
# LLM_BASE_URL=https://api.groq.com/openai/v1
# FAST_MODEL=llama-3.1-8b-instant
# DEEP_MODEL=llama-3.3-70b-versatile

# Tavily Search API key
TAVILY_API_KEY=

# Database: Neon Postgres pooled connection string (optional; if empty, embedded PGlite in data/pglite is used)
DATABASE_URL=

# Optional: User IANA timezone (defaults to system timezone, e.g. Asia/Kolkata, America/New_York)
USER_TZ=Asia/Kolkata

# Web server port
PORT=3000

# Optional: Fixed ISO timestamp for frozen-in-time evaluation (e.g. 2026-11-10T09:00:00+05:30)
FIXED_NOW=

# Logging level
LOG_LEVEL=info
