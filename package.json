{
  "name": "chatagent-monorepo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"server,web\" -c \"cyan.bold,magenta.bold\" \"npm run dev --workspace=@chatagent/server\" \"npm run dev --workspace=@chatagent/web\"",
    "build": "npm run build --workspace=@chatagent/web",
    "start": "npm start --workspace=@chatagent/server",
    "chat": "node apps/server/src/interfaces/cli/chat.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check:boundaries": "node scripts/check-boundaries.js",
    "test": "npm run test --workspace=@chatagent/server && npm run test --workspace=@chatagent/web",
    "eval": "node apps/server/evals/run.js",
    "eval:plumbing": "node apps/server/evals/run.js --mock",
    "db:migrate": "npm run db:migrate --workspace=@chatagent/server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "prettier": "^3.5.0"
  }
}
